{
  "cleanUrls": false,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Cache-Control", "value": "no-store" }
    ] }
  ],
  "redirects": [
    { "source": "/(admin|functions|tests)(/.*)?", "destination": "/", "permanent": false },
    { "source": "/README.md", "destination": "/", "permanent": false }
  ]
}
